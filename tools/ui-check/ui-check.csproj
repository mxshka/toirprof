<Project Sdk="Microsoft.NET.Sdk">
  <!--  Проверка экранов desktop-клиента без монитора: каждый экран и диалог
        открывается в headless-окне Avalonia, получает данные из живого API,
        ошибки привязок собираются, а кадр сохраняется в PNG.  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\desktop\ToirProf.Desktop.csproj" />
  </ItemGroup>
</Project>
