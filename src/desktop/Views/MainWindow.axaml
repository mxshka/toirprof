<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ToirProf.Desktop.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="860"
        MinWidth="1024"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding OpenByNameCommand}" CommandParameter="Dashboard" />
        <KeyBinding Gesture="Ctrl+D2" Command="{Binding OpenByNameCommand}" CommandParameter="Equipment" />
        <KeyBinding Gesture="Ctrl+D3" Command="{Binding OpenByNameCommand}" CommandParameter="Schedule" />
        <KeyBinding Gesture="Ctrl+D4" Command="{Binding OpenByNameCommand}" CommandParameter="WorkOrders" />
        <KeyBinding Gesture="Ctrl+D5" Command="{Binding OpenByNameCommand}" CommandParameter="Crews" />
        <KeyBinding Gesture="Ctrl+D6" Command="{Binding OpenByNameCommand}" CommandParameter="Materials" />
        <KeyBinding Gesture="Ctrl+D7" Command="{Binding OpenByNameCommand}" CommandParameter="Reports" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewOrderCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockScreenCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ShowHotkeysCommand}" />
    </Window.KeyBindings>

    <!--  Корневой Border задаёт фон всего окна и наследуемый шрифт.
         В Avalonia 12 Window — это TopLevel, а не Control, и у него нет
         свойства Background, поэтому фон красится именно так.
         FontFamily и FontSize наследуемые: доходят до всех потомков.  -->
    <Border x:Name="Root"
            Background="{DynamicResource BgBrush}"
            TextElement.FontFamily="{DynamicResource UiFont}"
            TextElement.FontSize="{Binding UiFontSize}">
    <Grid RowDefinitions="Auto,*">

        <!--  ================= верхняя панель =================  -->
        <Border Grid.Row="0" Classes="topbar">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,10">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="badge" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="ТП" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentScreenTitle}" Classes="h2" />
                        <TextBlock Text="{Binding StatusText}" Classes="caption" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{Binding NotificationsCaption}"
                            Command="{Binding ToggleNotificationsCommand}"
                            IsVisible="{Binding IsLoggedIn}"
                            ToolTip.Tip="Последние изменения заявок и оборудования" />
                    <Button Content="Настройки"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Шрифт, строки на странице, автоблокировка (Ctrl+,)" />
                    <Button Content="Блокировать"
                            Command="{Binding LockScreenCommand}"
                            IsVisible="{Binding IsLoggedIn}"
                            ToolTip.Tip="Заблокировать экран (Ctrl+L)" />
                    <Button Content="Обновить"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Обновить данные активного экрана (F5)" />
                    <Button Content="Выход"
                            Classes="danger"
                            Command="{Binding LogoutCommand}"
                            IsVisible="{Binding IsLoggedIn}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= рабочая область =================  -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <!--  Боковое меню. Скрыто на экране входа: там ещё нет роли,
                  и показывать пункты было бы обещанием, которое клиент
                  выполнить не сможет.  -->
            <Border Grid.Column="0" Classes="sidebar" Width="228" IsVisible="{Binding IsLoggedIn}">
                <DockPanel LastChildFill="True">

                    <Border DockPanel.Dock="Top" Padding="16,14" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="ТОиР-Проф" Classes="h2" />
                            <TextBlock Text="Мастер участка" Classes="caption" />
                        </StackPanel>
                    </Border>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding VisibleMenu}" Margin="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="menu"
                                        Command="{Binding $parent[Window].DataContext.OpenByNameCommand}"
                                        CommandParameter="{Binding Key}"
                                        ToolTip.Tip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Glyph}"
                                                   Classes="muted"
                                                   Width="18"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button DockPanel.Dock="Bottom"
                            Classes="menu"
                            Margin="0,0,0,8"
                            Command="{Binding ShowHotkeysCommand}"
                            Content="F1 — горячие клавиши" />
                </DockPanel>
            </Border>

            <!--  Правая часть: хлебные крошки, активный экран, тосты.  -->
            <Panel Grid.Column="1">

                <DockPanel LastChildFill="True">

                    <!--  Хлебные крошки показывают раздел и экран внутри него.  -->
                    <Border DockPanel.Dock="Top" Padding="20,10" IsVisible="{Binding IsLoggedIn}">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding}" Classes="muted" />
                                        <TextBlock Text="›" Classes="caption" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!--  Индикатор асинхронной загрузки. Пока идёт запрос,
                          подпись объясняет, что именно ждёт мастер.  -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
                            Padding="20,6" IsVisible="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressBar IsIndeterminate="True" Width="90" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusyCaption}" Classes="muted" />
                        </StackPanel>
                    </Border>

                    <!--  Активный экран. ViewLocator сам подставит нужное
                          окно по типу вьюмодели: на этом месте одинаково
                          открывается и форма входа, и любой рабочий
                          экран — различать их оболочке не нужно.  -->
                    <ContentControl Content="{Binding Page}" />
                </DockPanel>

                <!--  Уведомления: правый верхний угол поверх экрана,
                    чтобы мастер не терял список из-за сообщения.  -->
                <ItemsControl ItemsSource="{Binding Toasts}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,16,16,0"
                              Width="360"
                              IsHitTestVisible="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="toast">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Glyph}" FontWeight="Bold" Width="16" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="300" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Лента уведомлений: открывается кнопкой в верхней панели.  -->
                <Border Classes="card"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,16,0"
                        Width="400"
                        MaxHeight="520"
                        BorderBrush="{StaticResource AccentBrush}"
                        IsVisible="{Binding IsNotificationsOpen}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="Уведомления" Classes="h2" />
                            <Button Grid.Column="1" Content="Закрыть" Command="{Binding ToggleNotificationsCommand}" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Text="Событий пока нет" Classes="muted"
                                   IsVisible="{Binding !Notifications.Count}" />
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding When}" Classes="caption" />
                                            </Grid>
                                            <TextBlock Text="{Binding Text}" Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Panel>
        </Grid>

        <!--  Автоблокировка: экран закрыт до ввода пароля.  -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#F21B1F24"
                IsVisible="{Binding IsLocked}">
            <Border Classes="card" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Экран заблокирован" Classes="h1" />
                    <TextBlock Text="{Binding LockCaption}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WindowTitle}" Classes="caption" />
                    <TextBox Text="{Binding UnlockPassword}" PasswordChar="•" Watermark="пароль" />
                    <TextBlock Text="{Binding UnlockError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding UnlockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Разблокировать" Classes="primary" Command="{Binding UnlockCommand}" IsDefault="True" />
                        <Button Content="Выйти" Command="{Binding LogoutFromLockCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Border>
</Window>
