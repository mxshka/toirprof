<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.Screens.WorkOrdersView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,16,20,16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Заявки на ремонт и ТО" Classes="h1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding SearchText}" Width="240"
                         Watermark="номер заявки, оборудование, описание" />
                <Button Content="Найти" Command="{Binding SearchCommand}" />
                <Button Content="+ Аварийная" Classes="danger" Command="{Binding CreateCommand}" CommandParameter="Аварийная"
                        ToolTip.Tip="Новая аварийная заявка (Ctrl+N)" />
                <Button Content="+ Плановая" Classes="primary" Command="{Binding CreateCommand}" CommandParameter="Плановая" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Статус" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="160" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Приоритет" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityFilter}" Width="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Бригада" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Crews}" SelectedItem="{Binding CrewFilter}" Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Цех" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Workshops}" SelectedItem="{Binding WorkshopFilter}" Width="200" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Тип" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" Width="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                    <TextBlock Text="Создана с" Classes="caption" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FromFilter, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
                    <TextBlock Text="по" Classes="caption" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ToFilter, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
                </StackPanel>
                <Button Content="Применить" Classes="primary" Command="{Binding SearchCommand}" Margin="0,0,8,6" />
                <Button Content="Сбросить" Command="{Binding ResetFiltersCommand}" Margin="0,0,0,6" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,360">

            <Border Grid.Column="0" Classes="card" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectedItem="{Binding Selected}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="125" />
                            <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="230" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding OrderType}" Width="105" />
                            <DataGridTemplateColumn Header="Приоритет" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PriorityFill}" CornerRadius="3" Padding="6,1" Margin="4,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Priority}" Foreground="White" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Статус" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StatusFill}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="План" Binding="{Binding PlannedStart}" Width="110" />
                            <DataGridTextColumn Header="Простой, ч" Binding="{Binding DowntimeHours}" Width="110" />
                            <DataGridTextColumn Header="Цех" Binding="{Binding WorkshopName}" Width="150" />
                            <DataGridTextColumn Header="Бригада" Binding="{Binding CrewName}" Width="*" MinWidth="160" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Заявок нет"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !Rows.Count}" />
                </Grid>
            </Border>

            <!--  Панель работы с заявкой: слева создание черновика,
                  справа ведение выбранной заявки по её жизненному циклу.  -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                <TextBlock Grid.Row="0" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,12"
                           IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="Выберите заявку в таблице: здесь появятся действия по ней и хронология статусов." />

                <Border Grid.Row="0" Classes="card" Margin="0,0,0,12"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Selected.Number}" Classes="h2" />
                        <TextBlock Text="{Binding Selected.Title}" Classes="muted" TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Бригада" Classes="caption" />
                            <ComboBox ItemsSource="{Binding Crews}" SelectedItem="{Binding AssignCrew}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Назначить бригаду" HorizontalAlignment="Stretch"
                                Command="{Binding AssignCrewCommand}" />

                        <Button Content="В работу" HorizontalAlignment="Stretch"
                                Command="{Binding StartCommand}" />

                        <Button Content="Завершить (причина и материалы)…" HorizontalAlignment="Stretch"
                                Command="{Binding CompleteCommand}" />

                        <Button Content="Закрыть заявку" HorizontalAlignment="Stretch"
                                Command="{Binding CloseOrderCommand}" />

                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="card" Margin="0,0,0,12"
                        IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Хронология статусов" Classes="h2" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="{Binding Detail.FailureReason, StringFormat='Причина: {0}'}"
                                   IsVisible="{Binding Detail.FailureReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="caption"
                                   Text="{Binding Detail.TotalMaterialCost, StringFormat='Материалы: {0:N2} ₽'}" />
                        <ScrollViewer MaxHeight="260">
                            <ItemsControl ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="14,*" Margin="0,0,0,8">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Top" Margin="0,5,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                <TextBlock Classes="caption">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="When" />
                                                            <Binding Path="ChangedByName" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="card"
                        Background="{StaticResource BadSoftBrush}"
                        BorderBrush="{StaticResource BadBrush}"
                        IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Операция не выполнена" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ErrorText}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="&lt;&lt;" Command="{Binding FirstPageCommand}" />
                <Button Content="&lt;" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                <TextBlock Text="{Binding PageCaption}" Classes="muted" VerticalAlignment="Center" MinWidth="180" />
                <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="80" Margin="12,0,0,0"
                          ToolTip.Tip="Строк на странице" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="caption"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
