<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.Screens.EquipmentCardView">

    <Grid RowDefinitions="Auto,*,Auto" Margin="22" Height="560">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding Card.Name}" Classes="h2" />
            <TextBlock Text="{Binding Card.InventoryNumber}" Classes="muted" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Основная информация">
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <TextBlock Grid.Row="0" Text="Цех" Classes="caption" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Card.WorkshopName}" />
                    <TextBlock Grid.Row="1" Text="Статус" Classes="caption" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Card.Status}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="Критичность" Classes="caption" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Card.CriticalityCaption}" />
                    <TextBlock Grid.Row="3" Text="Производитель" Classes="caption" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Card.Manufacturer}" />
                    <TextBlock Grid.Row="4" Text="Модель" Classes="caption" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Card.Model}" />
                    <TextBlock Grid.Row="5" Text="Серийный номер" Classes="caption" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Card.SerialNumber}" />
                    <TextBlock Grid.Row="6" Text="Ввод в эксплуатацию" Classes="caption" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CommissionCaption}" />
                    <TextBlock Grid.Row="7" Text="Ввод в работу" Classes="caption" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding OperationCaption}" />
                    <TextBlock Grid.Row="8" Text="Списание" Classes="caption" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DecommissionCaption}" />
                    <TextBlock Grid.Row="9" Text="Место установки" Classes="caption" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Card.Location}" />
                    <TextBlock Grid.Row="10" Text="Примечание" Classes="caption" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Card.Notes}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding OrdersCaption}">
                <DataGrid ItemsSource="{Binding Card.Orders}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="120" />
                        <DataGridTextColumn Header="Создана" Binding="{Binding CreatedOn}" Width="100" />
                        <DataGridTextColumn Header="Тип" Binding="{Binding OrderType}" Width="110" />
                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="110" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="Простой, ч" Binding="{Binding DowntimeHours}" Width="100" />
                        <DataGridTextColumn Header="Бригада" Binding="{Binding CrewName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="{Binding MaintenanceCaption}">
                <DataGrid ItemsSource="{Binding Card.Maintenance}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Вид ТО" Binding="{Binding TypeName}" Width="*" />
                        <DataGridTextColumn Header="План" Binding="{Binding PlannedDate}" Width="110" />
                        <DataGridTextColumn Header="Факт" Binding="{Binding CompletedDate}" Width="110" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130" />
                        <DataGridTextColumn Header="Стоимость" Binding="{Binding ActualCost}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Закрыть" Classes="primary" HorizontalAlignment="Right" Margin="0,12,0,0"
                Command="{Binding CancelCommand}" />
    </Grid>
</UserControl>
