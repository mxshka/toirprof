<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.Screens.ScheduleAddView">

    <StackPanel Margin="22" Spacing="12">
        <TextBlock Text="{Binding Title}" Classes="h2" />

        <StackPanel Spacing="4">
            <TextBlock Text="Оборудование *" Classes="caption" />
            <ComboBox ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}" HorizontalAlignment="Stretch" PlaceholderText="выберите оборудование">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SelectCaption}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Вид обслуживания *" Classes="caption" />
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Плановая дата *" Classes="caption" />
            <DatePicker SelectedDate="{Binding PlannedDate, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Примечание" Classes="caption" />
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
        </StackPanel>

        <Border Classes="card" Background="{StaticResource BadSoftBrush}" BorderBrush="{StaticResource BadBrush}"
                IsVisible="{Binding HasErrors}">
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Отмена" Command="{Binding CancelCommand}" />
            <Button Content="Добавить" Classes="primary" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
