<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Desktop.Views.Screens.ScheduleView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20,16,20,16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="График планового ТО" Classes="h1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="с" Classes="caption" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding From, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
                <TextBlock Text="по" Classes="caption" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding To, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding StatusFilter}" Width="160" />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card"
                Background="{StaticResource BadSoftBrush}"
                BorderBrush="{StaticResource BadBrush}"
                Margin="0,0,0,12"
                IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="4">
                <TextBlock Text="График не загрузился" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ErrorText}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,320">

            <TabControl Grid.Column="0" Margin="0,0,12,0">
                <TabItem Header="Календарь">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="&lt;" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Предыдущий месяц" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MonthCaption}" Classes="h2" Width="170" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Content="&gt;" Command="{Binding NextMonthCommand}" ToolTip.Tip="Следующий месяц" Margin="6,0,6,0" />
                            <Button Content="Сегодня" Command="{Binding CurrentMonthCommand}" Margin="0,0,18,0" />

                            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BadBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OverdueCount, StringFormat='просрочено: {0}'}" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource WaitBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SoonCount, StringFormat='ближайшие 3 дня: {0}'}" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource OkBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="выполнено" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="заявка создана" Classes="caption" VerticalAlignment="Center" />
                        </WrapPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="caption" TextAlignment="Center" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{Binding BorderFill}"
                                            BorderThickness="1" CornerRadius="4" Margin="2" Padding="4"
                                            Opacity="{Binding Opacity}" ClipToBounds="True"
                                            DoubleTapped="OnDayDoubleTapped"
                                            ToolTip.Tip="Двойной щелчок — добавить запись на этот день">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding DayNumber}" Classes="caption" />
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="{Binding Fill}" Foreground="White" FontSize="11"
                                                                Padding="4,1" Margin="0,1,0,0" BorderThickness="0"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                ToolTip.Tip="{Binding Tooltip}"
                                                                Command="{Binding $parent[UserControl].DataContext.SelectCommand}"
                                                                CommandParameter="{Binding Row}">
                                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>

                <TabItem Header="Список">
            <Border Classes="card" Padding="0" Margin="0,8,0,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectedItem="{Binding Selected}"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="*" />
                            <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNumber}" Width="130" />
                            <DataGridTextColumn Header="Вид ТО" Binding="{Binding MaintenanceTypeName}" Width="180" />
                            <DataGridTextColumn Header="План" Binding="{Binding PlannedDate}" Width="120" />
                            <DataGridTextColumn Header="Факт" Binding="{Binding CompletedDate}" Width="120" />
                            <DataGridTextColumn Header="Следующее" Binding="{Binding NextPlannedDate}" Width="130" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Записей за период нет"
                               Classes="muted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !Rows.Count}" />
                </Grid>
            </Border>
                </TabItem>
            </TabControl>

            <!--  Отметка о выполнении. Стоит справа от графика: мастер
                  открыл строку и сразу видит, что нужно вписать.  -->
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="12">

                    <TextBlock Text="Выполнение ТО" Classes="h2" />

                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Выберите запись в графике, чтобы отметить выполнение." />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Дата выполнения" Classes="caption" />
                        <DatePicker SelectedDate="{Binding CompletedDate, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}" DayFormat="dd" MonthFormat="MM" YearFormat="yyyy" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Фактическая стоимость, ₽" Classes="caption" />
                        <NumericUpDown Value="{Binding ActualCost}" FormatString="0.00"
                                       Minimum="0" Increment="100" />
                    </StackPanel>

                    <Button Content="Отметить выполненным"
                            Classes="primary"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CompleteCommand}" />

                    <Button Content="Вернуть в план"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ReturnToPlanCommand}" />

                    <Button Content="Создать заявку"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="Плановая заявка по выбранной записи; запись получит статус «Назначено»"
                            Command="{Binding CreateOrderCommand}" />

                    <Button Content="+ Запись графика"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding CanPlan}"
                            Command="{Binding AddEntryCommand}" />

                    <Border Classes="card" Padding="0"
                            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Selected.MaintenanceTypeName}" Classes="h2" />
                            <TextBlock Text="{Binding Selected.EquipmentName}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.Notes}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="&lt;&lt;" Command="{Binding FirstPageCommand}" />
                <Button Content="&lt;" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                <TextBlock Text="{Binding PageCaption}" Classes="muted" VerticalAlignment="Center" MinWidth="180" />
                <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="caption"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
