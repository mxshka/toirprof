<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToirProf.Mobile.Views.EquipmentView">
    <ScrollViewer>
        <StackPanel Margin="16,14,16,90" Spacing="12">
            <Button Classes="big primary" Content="Сканировать QR-код" Command="{Binding ScanCommand}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Code}" PlaceholderText="инвентарный номер, например ТС-11" />
                <Button Grid.Column="1" Content="Найти" Command="{Binding FindCommand}" MinHeight="46" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Hint}" Classes="muted"
                       IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="12" IsVisible="{Binding HasCard}">
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Card.Name}" Classes="h2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Card.InventoryNumber}" Classes="caption" />
                        <TextBlock Text="{Binding Card.Status, StringFormat='Статус: {0}'}" />
                        <TextBlock Text="{Binding Card.WorkshopName}" Classes="caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Card.Location}" Classes="caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Card.Passport}" Classes="caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Card.Notes}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Button Classes="big danger" Content="Сообщить о неисправности" Command="{Binding CreateOrderCommand}" />

                <TextBlock Text="Активные заявки" Classes="h2" />
                <TextBlock Text="Открытых заявок нет" Classes="muted" IsVisible="{Binding !Card.ActiveOrders.Count}" />
                <ItemsControl ItemsSource="{Binding Card.ActiveOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="row" Command="{Binding $parent[UserControl].DataContext.OpenOrderCommand}" CommandParameter="{Binding}">
                                <StackPanel Margin="14,10" Spacing="2">
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Status" />
                                                <Binding Path="Priority" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Типовые неисправности" Classes="h2" />
                <Border Classes="card">
                    <ItemsControl ItemsSource="{Binding Card.TypicalFaults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Spacing="1">
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}случаев: {0}, последний {1:dd.MM.yyyy}">
                                                <Binding Path="Count" />
                                                <Binding Path="LastSeen" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="ТО и инструкции" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Card.Maintenance}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:dd.MM.yyyy} · {1}">
                                                <Binding Path="PlannedDate" />
                                                <Binding Path="Status" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Instruction}" Classes="muted" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
